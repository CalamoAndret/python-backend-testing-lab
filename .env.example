# Local development only; replace these values in any shared deployment.
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab
POSTGRES_DB=testing_lab
DATABASE_URL=postgresql+asyncpg://lab:lab@localhost:5432/testing_lab
# Tests truncate their dedicated database. Never point this at application data.
TEST_DATABASE_URL=postgresql+asyncpg://lab:lab@localhost:5432/testing_lab_test
